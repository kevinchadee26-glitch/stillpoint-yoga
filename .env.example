# Copy to .env for local dev, and set the same two values in Netlify > Site settings > Environment variables.
# The anon (publishable) key is safe in the browser because every table is protected by row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
